{
  "name": "S1 Tax",
  "short_name": "S1 Tax",
  "description": "Buchhaltung für S1 Secure e.U.: Belege, Bankabgleich, UVA, Rechnungen.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3F4F1",
  "theme_color": "#16224A",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./#teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "belege", "accept": ["application/pdf", "image/*"] }] }
  }
}
